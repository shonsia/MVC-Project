@{
    ViewData["Title"] = "Shaun Sia | Portfolio";
}

<div style="max-width: 960px; margin: 4rem auto; padding: 2rem; font-family: Arial, sans-serif; color: #111827;">
    <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">Shaun Sia</h1>
    <p style="font-size: 1.1rem; letter-spacing: 0.08em; text-transform: uppercase; color: #4b5563; margin-bottom: 2rem;">
        Graphic Designer • UI/UX • Video Editor • Photographer
    </p>

    <p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
        I create thoughtful visuals and digital experiences that connect storytelling, design, and technology.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <div style="padding: 1.25rem; border: 1px solid #e5e7eb; border-radius: 12px; background: #f9fafb;">
            <h2 style="margin-top: 0; font-size: 1.1rem;">Design</h2>
            <p>Branding, layouts, and polished visual systems.</p>
        </div>
        <div style="padding: 1.25rem; border: 1px solid #e5e7eb; border-radius: 12px; background: #f9fafb;">
            <h2 style="margin-top: 0; font-size: 1.1rem;">UI/UX</h2>
            <p>User-focused interfaces built for clarity and impact.</p>
        </div>
        <div style="padding: 1.25rem; border: 1px solid #e5e7eb; border-radius: 12px; background: #f9fafb;">
            <h2 style="margin-top: 0; font-size: 1.1rem;">Media</h2>
            <p>Video editing and photography for modern storytelling.</p>
        </div>
    </div>
</div>
